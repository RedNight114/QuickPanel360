# ============================================================
# QuickPanel360 — Web (Next.js) environment variables
# QuickAgence
#
# Copia como ".env.local" para desarrollo.
# NEXT_PUBLIC_* son visibles en el navegador — NUNCA pongas secretos aquí.
# ============================================================

# URL pública de la API (accesible desde el navegador del cliente)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Nombre de la aplicación (usado en title tags, etc.)
NEXT_PUBLIC_APP_NAME=QuickPanel360

# Build info — inyectadas por CI/CD, no editar manualmente en producción
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_GIT_SHA=local
NEXT_PUBLIC_BUILD_DATE=local
