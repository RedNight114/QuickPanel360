# ============================================================
# QuickPanel360 — Web (Next.js) production environment
# QuickAgence
#
# Copia como apps/web/.env.production
# ============================================================

# URL pública de la API — debe ser accesible desde el navegador del usuario
# (no desde dentro de Docker, sino la URL externa)
NEXT_PUBLIC_API_URL=https://api.tudominio.com

NEXT_PUBLIC_APP_NAME=QuickPanel360

# Build info — inyectadas automáticamente en CI/CD (no editar manualmente)
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_GIT_SHA=
NEXT_PUBLIC_BUILD_DATE=
