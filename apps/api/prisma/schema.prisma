}

model PlatformAuditLog {
  id          String  @id @default(uuid())
  actorUserId String?
  tenantId    String?

  action     String
  entityType String
  entityId   String?

  oldValue Json?
  newValue Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  actorUser User?   @relation("PlatformAuditActor", fields: [actorUserId], references: [id])
  tenant    Tenant? @relation(fields: [tenantId], references: [id])

  @@index([actorUserId])
  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("platform_audit_logs")
}

model PlatformSupportSession {
  id         String  @id @default(uuid())
  tenantId   String
  openedById String
  closedById String?

  reason String
  status PlatformSupportSessionStatus @default(OPEN)
  notes  String?

  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openedBy User   @relation("PlatformSupportOpenedBy", fields: [openedById], references: [id])
  closedBy User?  @relation("PlatformSupportClosedBy", fields: [closedById], references: [id])

  @@index([tenantId])
  @@index([openedById])
  @@index([status])
  @@index([openedAt])
  @@map("platform_support_sessions")
}

model PlatformInvoice {
  id          String                @id @default(uuid())
  tenantId    String
  number      String                @unique
  description String?
  amount      Decimal               @db.Decimal(10, 2)
  currency    String                @default("EUR")
  status      PlatformInvoiceStatus @default(ISSUED)
  issuedAt    DateTime              @default(now())
  dueAt       DateTime?
  paidAt      DateTime?
  voidedAt    DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments PlatformPayment[]

  @@index([tenantId])
  @@index([status])
  @@index([issuedAt])
  @@map("platform_invoices")
}

model PlatformPayment {
  id        String                @id @default(uuid())
  tenantId  String
  invoiceId String?
  amount    Decimal               @db.Decimal(10, 2)
  currency  String                @default("EUR")
  method    String?
  reference String?
  status    PlatformPaymentStatus @default(PAID)
  paidAt    DateTime              @default(now())
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice PlatformInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([status])
  @@index([paidAt])
  @@map("platform_payments")
}

model InternalNotification {
  id       String  @id @default(uuid())
  tenantId String
  userId   String?

  type     NotificationType
  priority NotificationPriority @default(INFO)
  status   NotificationStatus   @default(UNREAD)

  title      String
  message    String
  entityType String?
  entityId   String?
  metadata   Json?

  readAt     DateTime?
  resolvedAt DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation("NotificationUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([type])
  @@index([priority])
  @@index([status])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("internal_notifications")
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  tenantId   String
  tokenHash  String
  deviceName String?
  userAgent  String?
  ipAddress  String?
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation("UserSessionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tenantId])
  @@index([tokenHash])
  @@map("user_sessions")
}

model UserNotificationPreference {
  id               String           @id @default(uuid())
  userId           String
  tenantId         String
  notificationType NotificationType
  enabled          Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation("UserNotifPrefs", fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation("TenantNotifPrefs", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, notificationType])
  @@index([userId, tenantId])
  @@map("user_notification_preferences")
}

// ======================================================
// CONFIGURACION DE PLATAFORMA (SINGLETON)
// ======================================================

model PlatformSettings {
  id String @id @default("singleton")

  platformName     String  @default("QuickPanel360")
  contactEmail     String  @default("")
  supportEmail     String  @default("")
  logoUrl          String  @default("")
  defaultLocale    String  @default("es")
  defaultTimezone  String  @default("Europe/Madrid")

  notifyNewLead        Boolean @default(true)
  notifyEmergency      Boolean @default(true)
  notifyPaymentOverdue Boolean @default(true)
  notifyTrialExpiring  Boolean @default(true)
  notifyNewTenant      Boolean @default(true)
  notifySuspension     Boolean @default(true)
  emailNotifications   Boolean @default(false)

  minPasswordLength      Int     @default(8)
  sessionTimeoutMinutes  Int     @default(480)
  maxLoginAttempts       Int     @default(5)
  requireStrongPasswords Boolean @default(true)

  invoicePrefix     String @default("INV")
  defaultCurrency   String @default("CR")
  platformLegalName String @default("")
  platformTaxId     String @default("")
  platformAddress   String @default("")
  platformCity      String @default("")
  platformCountry   String @default("ES")

  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ======================================================
// PORTAL DEL SOCIO — FASE 1
// ======================================================

enum PointTransactionType {
  EARNED
  REDEEMED
  ADJUSTED
  EXPIRED
}

model MemberSession {
  id        String  @id @default(uuid())
  tenantId  String
  memberId  String
  tokenHash String  @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())

  tenant Tenant @relation("TenantMemberSessions", fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation("MemberSessions", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId, memberId])
  @@index([tokenHash])
  @@map("member_sessions")
}

model MemberPointBalance {
  id             String @id @default(uuid())
  tenantId       String
  memberId       String
  points         Int    @default(0)
  lifetimePoints Int    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation("TenantMemberPoints", fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation("MemberPointBalance", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tenantId, memberId])
  @@map("member_point_balances")
}

model MemberPointTransaction {
  id         String               @id @default(uuid())
  tenantId   String
  memberId   String
  type       PointTransactionType
  points     Int
  reason     String
  sourceType String?
  sourceId   String?
  metadata   Json?
  createdAt  DateTime             @default(now())

  tenant Tenant @relation("TenantMemberPointTx", fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation("MemberPointTransactions", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId, memberId, createdAt(sort: Desc)])
  @@map("member_point_transactions")
}

model MemberAppSettings {
  id                     String  @id @default(uuid())
  tenantId               String  @unique
  enabled                Boolean @default(false)
  catalogEnabled         Boolean @default(true)
  showProductValues      Boolean @default(false)
  showApproxAvailability Boolean @default(false)
  pointsEnabled          Boolean @default(true)
  allowProfileEdit       Boolean @default(true)
  digitalCardEnabled     Boolean @default(true)
  gamesEnabled           Boolean @default(false)
  missionsEnabled        Boolean @default(false)
  rewardsEnabled         Boolean @default(false)
  allowRewardRedemption  Boolean @default(true)
  requireRewardApproval  Boolean @default(true)
  maxDailyGamePlays      Int     @default(5)
  maxDailyPointsFromGames Int    @default(50)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant Tenant @relation("TenantMemberAppSettings", fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("member_app_settings")
}

// ======================================================
// PORTAL DEL SOCIO — FASE 2: JUEGOS, MISIONES, RECOMPENSAS
// ======================================================

enum RewardGameType {
  DAILY_CHECKIN
  QUIZ
  SPIN
  SURVEY
  CUSTOM
  BUBBLE_POP
  MEMORY_CARDS
  BLOCK_PUZZLE
  RUNNER
  REACTION_TAP
}

enum RewardGameSessionStatus {
  STARTED
  FINISHED
  EXPIRED
  CANCELLED
}

model RewardGameSession {
  id            String                   @id @default(uuid())
  tenantId      String
  gameId        String
  memberId      String
  status        RewardGameSessionStatus  @default(STARTED)
  seed          String?
  startedAt     DateTime                 @default(now())
  finishedAt    DateTime?
  expiresAt     DateTime
  score         Int?
  pointsAwarded Int                      @default(0)
  metadata      Json?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  tenant Tenant     @relation("TenantGameSessions", fields: [tenantId], references: [id], onDelete: Cascade)
  game   RewardGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  member Member     @relation("MemberGameSessions", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId, memberId, createdAt(sort: Desc)])
  @@index([tenantId, gameId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@map("reward_game_sessions")
}

enum RewardGameStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MissionType {
  COMPLETE_PROFILE
  DAILY_ACCESS
  QUIZ_PARTICIPATION
  CHECK_IN
  GAME_PLAY
  CUSTOM
}

enum MissionStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum RewardStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum RewardRedemptionStatus {
  REQUESTED
  APPROVED
  REJECTED
  DELIVERED
  CANCELLED
}

model RewardGame {
  id           String           @id @default(uuid())
  tenantId     String
  title        String
  description  String?
  type         RewardGameType
  status       RewardGameStatus @default(ACTIVE)
  pointsReward Int              @default(5)
  cooldownHours Int             @default(24)
  maxPlaysPerDay Int            @default(1)
  config       Json?
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant   Tenant               @relation("TenantRewardGames", fields: [tenantId], references: [id], onDelete: Cascade)
  plays    RewardGamePlay[]
  sessions RewardGameSession[]

  @@index([tenantId, status])
  @@map("reward_games")
}

model RewardGamePlay {
  id           String @id @default(uuid())
  tenantId     String
  gameId       String
  memberId     String
  result       String?
  pointsEarned Int    @default(0)
  metadata     Json?
  createdAt    DateTime @default(now())

  tenant Tenant     @relation("TenantGamePlays", fields: [tenantId], references: [id], onDelete: Cascade)
  game   RewardGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  member Member     @relation("MemberGamePlays", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId, memberId, createdAt(sort: Desc)])
  @@index([tenantId, gameId, memberId, createdAt(sort: Desc)])
  @@map("reward_game_plays")
}

model Mission {
  id           String        @id @default(uuid())
  tenantId     String
  title        String
  description  String?
  type         MissionType
  status       MissionStatus @default(ACTIVE)
  pointsReward Int           @default(25)
  targetValue  Int           @default(1)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant   Tenant                  @relation("TenantMissions", fields: [tenantId], references: [id], onDelete: Cascade)
  progress MemberMissionProgress[]

  @@index([tenantId, status])
  @@map("missions")
}

model MemberMissionProgress {
  id            String    @id @default(uuid())
  tenantId      String
  missionId     String
  memberId      String
  progress      Int       @default(0)
  completedAt   DateTime?
  pointsAwarded Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant  Tenant  @relation("TenantMissionProgress", fields: [tenantId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  member  Member  @relation("MemberMissionProgress", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tenantId, missionId, memberId])
  @@index([tenantId, memberId])
  @@map("member_mission_progress")
}

model Reward {
  id               String       @id @default(uuid())
  tenantId         String
  title            String
  description      String?
  pointsCost       Int
  status           RewardStatus @default(ACTIVE)
  stockLimit       Int?
  currentStock     Int?
  requiresApproval Boolean      @default(true)
  imageUrl         String?
  terms            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant      Tenant              @relation("TenantRewards", fields: [tenantId], references: [id], onDelete: Cascade)
  redemptions RewardRedemption[]

  @@index([tenantId, status])
  @@map("rewards")
}

model RewardRedemption {
  id           String                  @id @default(uuid())
  tenantId     String
  rewardId     String
  memberId     String
  pointsSpent  Int
  status       RewardRedemptionStatus  @default(REQUESTED)
  reviewedById String?
  reviewedAt   DateTime?
  deliveredAt  DateTime?
  notes        String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  tenant   Tenant @relation("TenantRedemptions", fields: [tenantId], references: [id], onDelete: Cascade)
  reward   Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  member   Member @relation("MemberRedemptions", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId, memberId, createdAt(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("reward_redemptions")
}


model MemberPushSubscription {
  id        String   @id @default(uuid())
  tenantId  String
  memberId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  tenant Tenant @relation("TenantMemberPush", fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation("MemberPushSubs", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("member_push_subscriptions")
}

model AdminPushSubscription {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user   User   @relation("AdminPushSubs", fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation("TenantAdminPush", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_push_subscriptions")
}
