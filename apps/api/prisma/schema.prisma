  tenantId      String                   @unique
  assignedToId  String?
  status        PlatformCollectionStatus @default(OPEN)
  notes         String?
  openedAt      DateTime                 @default(now())
  lastContactAt DateTime?
  nextActionAt  DateTime?
  promiseDate   DateTime?
  closedAt      DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo User?  @relation("CollectionAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([assignedToId])
  @@index([nextActionAt])
  @@map("tenant_collection_cases")
}

model TenantAccountActivity {
  id          String                      @id @default(uuid())
  tenantId    String
  actorUserId String?
  type        PlatformAccountActivityType @default(NOTE)
  title       String
  notes       String?
  metadata    Json?
  createdAt   DateTime                    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("PlatformAccountActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([actorUserId])
  @@index([type])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
