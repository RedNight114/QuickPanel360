// ======================================================
// Prisma Schema — TPV Multiempresa para Clubes
// MVP v0.1
// ======================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS GENERALES
// ======================================================

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
  ARCHIVED
}

enum TenantAccessStatus {
  ENABLED
  DISABLED
  EMERGENCY_LOCKED
  MAINTENANCE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  DELETED
}

enum TenantUserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum UserRole {
  SUPERADMIN
  OWNER
  MANAGER
  EMPLOYEE
}

enum MemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
  INACTIVE
  DELETED
}

enum MemberClass {
  STANDARD
  PREFERRED
  VIP
}

enum MemberNoteVisibility {
  OWNER_ONLY
  MANAGER_AND_OWNER
  ALL_STAFF
}

enum IncidentType {
  WARNING
  PAYMENT_ISSUE
  BEHAVIOR
  DOCUMENT_ISSUE
  BAN
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum UnitType {
  KG
  GRAM
  UNIT
  ML
  PACK
}

enum SaleItemPricingMode {
  BY_UNIT
  BY_WEIGHT
  BY_AMOUNT
}

enum InventoryMovementType {
  STOCK_IN
  SALE
  ADJUSTMENT
  WASTE
  LOSS
  DAMAGED
  SAMPLE
  RETURN
  CORRECTION
}

enum ScaleToleranceAction {
  BLOCK
  REQUIRE_MANAGER_CONFIRMATION
  ALLOW_WITH_WARNING
}

enum PosSessionStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
  PENDING
}

enum SaleType {
  STANDARD
  CREDIT
  PARTIAL_CREDIT
  SPECIAL
}

enum SettlementStatus {
  PAID
  PARTIALLY_PAID
  PENDING
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BIZUM
  TRANSFER
  MIXED
}

enum PaymentStatus {
  COMPLETED
  PENDING
  FAILED
  REFUNDED
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
  CORRECTION
  EXPENSE
  SALE_CASH_IN
  RECEIVABLE_CASH_IN
  THIRD_PARTY_CASH_OUT
  WITHDRAWAL
  CORRECTION_IN
  CORRECTION_OUT
}

enum ReceivableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum ThirdPartyType {
  SUPPLIER
  SERVICE_PROVIDER
  COLLABORATOR
  OTHER
}

enum ThirdPartyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ThirdPartyPaymentCategory {
  SUPPLIER_PAYMENT
  SERVICE_PAYMENT
  COLLABORATOR_PAYMENT
  CASH_WITHDRAWAL
  EXPENSE
  OTHER
}

enum ThirdPartyPaymentStatus {
  PAID
  CANCELLED
}

enum AccessLinkStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum EmergencyLockStatus {
  ACTIVE
  RESOLVED
}

enum PlatformPlanStatus {
  ACTIVE
  ARCHIVED
}

enum TenantSubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
  PAST_DUE
}

enum PlatformSupportSessionStatus {
  OPEN
  CLOSED
}

enum PlatformInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum PlatformPaymentStatus {
  PAID
  REFUNDED
}

enum PlatformModuleStatus {
  ACTIVE
  ARCHIVED
}

enum TenantModuleStatus {
  ENABLED
  DISABLED
}

enum TenantLifecycleStage {
  LEAD
  NEW_SIGNUP
  ONBOARDING
  ACTIVE_STABLE
  ACTIVE_AT_RISK
  SUSPENDED
  CHURNED
}

enum TenantRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum PlatformAccountHealth {
  STABLE
  FOLLOW_UP
  AT_RISK
  BLOCKED
}

enum PlatformCollectionStatus {
  OPEN
  CONTACTED
  PROMISE
  DISPUTED
  CLOSED
}

enum PlatformAccountActivityType {
  NOTE
  CONTACT
  COLLECTION
  PAYMENT
  PROMISE
  STATUS_CHANGE
  RENEWAL
}

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum NotificationType {
  INVENTORY_LOW
  INVENTORY_OUT
  SCALE_TOLERANCE_EXCEEDED
  POSITIVE_WASTE_HIGH
  NEGATIVE_DIFFERENCE
  CASH_DIFFERENCE
  CASH_OPEN_TOO_LONG
  MEMBER_BIRTHDAY
  MEMBER_PENDING_CONTRIBUTION
  SECURITY_ALERT
  EMERGENCY_ACTIVE
  SYSTEM
  TRIAL_EXPIRING
  INVOICE_OVERDUE
  SUSPENSION_WARNING
  PLAN_LIMIT_WARNING
}

enum NotificationPriority {
  INFO
  WARNING
  IMPORTANT
  CRITICAL
}

enum NotificationStatus {
  UNREAD
  READ
  IN_REVIEW
  RESOLVED
  ARCHIVED
}

enum ChatConversationType {
  DIRECT
  GROUP
  SUPPORT
}

enum ChatMessageType {
  TEXT
  SYSTEM
}

enum ChatParticipantRole {
  OWNER
  MEMBER
}

// ======================================================
// SISTEMA MULTIEMPRESA
// ======================================================

model Tenant {
  id         String  @id @default(uuid())
  name       String
  legalName  String?
  taxId      String?
  email      String?
  phone      String?
  address    String?
  city       String?
  postalCode String?
  country    String  @default("ES")

  status                TenantStatus         @default(ACTIVE)
  accessStatus          TenantAccessStatus   @default(ENABLED)
  lifecycleStage        TenantLifecycleStage @default(NEW_SIGNUP)
  riskLevel             TenantRiskLevel       @default(LOW)
  accountHealth         PlatformAccountHealth @default(STABLE)
  platformNotes         String?
  lastContactAt         DateTime?
  nextReviewAt          DateTime?
  onboardingStartedAt   DateTime?
  onboardingCompletedAt DateTime?
  activatedAt           DateTime?
  accountOwnerId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   TenantUser[]
  members                 Member[]
  memberClassBenefits     MemberClassBenefit[]
  categories              ProductCategory[]
  products                Product[]
  inventory               Inventory[]
  movements               InventoryMovement[]
  posSessions             PosSession[]
  sales                   Sale[]
  payments                Payment[]
  cashMovements           CashMovement[]
  receivables             Receivable[]
  receivablePayments      ReceivablePayment[]
  thirdParties            ThirdParty[]
  thirdPartyPayments      ThirdPartyPayment[]
  accessLinks             AccessLink[]
  emergencyLocks          EmergencyLock[]
  auditLogs               AuditLog[]
  platformAuditLogs       PlatformAuditLog[]
  subscription            TenantSubscription?
  modules                 TenantModule[]
  supportSessions         PlatformSupportSession[]
  platformInvoices        PlatformInvoice[]
  platformPayments        PlatformPayment[]
  convertedFromLead       CommercialLead?
  contacts                TenantContact[]
  onboardingTasks         TenantOnboardingTask[]
  settings                TenantSettings?
  chatConversations       ChatConversation[]
  chatParticipants        ChatParticipant[]
  chatMessages            ChatMessage[]
  chatDeviceKeys          ChatDeviceKey[]
  notifications           InternalNotification[]
  notificationPreferences UserNotificationPreference[] @relation("TenantNotifPrefs")
  accountOwner            User?                        @relation("TenantAccountOwner", fields: [accountOwnerId], references: [id], onDelete: SetNull)
  collectionCase          TenantCollectionCase?
  accountActivities       TenantAccountActivity[]
  memberSessions          MemberSession[]           @relation("TenantMemberSessions")
  memberPointBalances     MemberPointBalance[]      @relation("TenantMemberPoints")
  memberPointTransactions MemberPointTransaction[]  @relation("TenantMemberPointTx")
  memberAppSettings       MemberAppSettings?        @relation("TenantMemberAppSettings")
  rewardGames             RewardGame[]              @relation("TenantRewardGames")
  rewardGamePlays         RewardGamePlay[]          @relation("TenantGamePlays")
  missions                Mission[]                 @relation("TenantMissions")
  missionProgress         MemberMissionProgress[]   @relation("TenantMissionProgress")
  rewards                 Reward[]                  @relation("TenantRewards")
  rewardRedemptions       RewardRedemption[]        @relation("TenantRedemptions")
  rewardGameSessions      RewardGameSession[]       @relation("TenantGameSessions")
  memberPushSubscriptions MemberPushSubscription[]  @relation("TenantMemberPush")
  adminPushSubscriptions  AdminPushSubscription[]   @relation("TenantAdminPush")

  @@index([status])
  @@index([accessStatus])
  @@index([lifecycleStage])
  @@index([riskLevel])
  @@index([accountHealth])
  @@index([accountOwnerId])
  @@map("tenants")
}

model TenantSettings {
  id       String @id @default(uuid())
  tenantId String @unique

  displayName  String?
  logoUrl      String?
  primaryColor String?
  accentColor  String?

  currency String @default("EUR")
  locale   String @default("es-ES")
  timezone String @default("Atlantic/Canary")

  allowCreditSales             Boolean              @default(true)
  requireCreditReason          Boolean              @default(true)
  allowSpecialSales            Boolean              @default(false)
  requireCashCloseConfirmation Boolean              @default(true)
  autoGenerateMemberNumber     Boolean              @default(false)
  memberNumberPrefix           String?
  minimumMemberAge             Int?
  showSecurityBadges           Boolean              @default(true)
  requireAccessLink            Boolean              @default(true)
  allowCashDiscrepancyClose    Boolean              @default(true)
  requireCashDiscrepancyReason Boolean              @default(false)
  scaleVerificationEnabled     Boolean              @default(true)
  requireScaleVerification     Boolean              @default(true)
  maxWastePerLineGrams         Decimal              @default(0.05) @db.Decimal(10, 3)
  maxWastePercent              Decimal              @default(5) @db.Decimal(6, 2)
  scaleToleranceAction         ScaleToleranceAction @default(BLOCK)
  allowUnderWeight             Boolean              @default(false)
  scalePrecisionGrams          Decimal              @default(0.01) @db.Decimal(10, 3)
  autoRegisterScaleWaste       Boolean              @default(true)
  scaleWasteReason             String               @default("Diferencia por peso real en báscula")
  showScaleStepOnMobile        Boolean              @default(true)
  requireMemberPhoto           Boolean              @default(false)

  // ── Inventario ──────────────────────────────────────────────────────────────
  blockDispensationIfNoStock Boolean @default(false)
  lowStockAlertEnabled       Boolean @default(true)
  lowStockThresholdGrams     Decimal @default(50) @db.Decimal(10, 3)
  requireAdjustmentReason    Boolean @default(false)
  requireWasteReason         Boolean @default(false)
  showNegativeScaleDiff      Boolean @default(true)
  inventoryDisplayUnit       String  @default("g")

  // ── Caja ────────────────────────────────────────────────────────────────────
  recommendedOpeningCash      Decimal? @db.Decimal(10, 2)
  alertOpenCashSessionMinutes Int?

  // ── Apariencia ──────────────────────────────────────────────────────────────
  defaultDensity String @default("comfortable")

  // ── Punto de dispensación ───────────────────────────────────────────────────
  quickWeightValuesGrams String  @default("1,2,3,5")
  showReceiptAfterSale   Boolean @default(true)

  // ── Notificaciones del club ──────────────────────────────────────────────────
  notifyLowStock        Boolean @default(true)
  notifyCashDiscrepancy Boolean @default(true)
  notifyHighWaste       Boolean @default(false)
  notifyMemberBirthday  Boolean @default(true)
  notifyHighReceivables Boolean @default(false)
  notifyEmergency       Boolean @default(true)
  notifySupportActivity Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberClassConfig MemberClassConfig[]

  @@map("tenant_settings")
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  phone        String?
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  totpSecret   String?
  totpEnabled  Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants TenantUser[]

  createdMembers Member[] @relation("MemberCreatedBy")
  updatedMembers Member[] @relation("MemberUpdatedBy")

  createdProducts Product[] @relation("ProductCreatedBy")

  openedPosSessions PosSession[] @relation("PosSessionOpenedBy")
  closedPosSessions PosSession[] @relation("PosSessionClosedBy")

  salesSold              Sale[]     @relation("SaleSoldBy")
  salesCancelled         Sale[]     @relation("SaleCancelledBy")
  salesApproved          Sale[]     @relation("SaleApprovedBy")
  scaleVerifiedSaleItems SaleItem[] @relation("SaleItemScaleVerifiedBy")
  scaleOverrideSaleItems SaleItem[] @relation("SaleItemScaleOverrideBy")

  inventoryMovements InventoryMovement[] @relation("InventoryMovementCreatedBy")

  cashMovements               CashMovement[]      @relation("CashMovementCreatedBy")
  receivablesCreated          Receivable[]        @relation("ReceivableCreatedBy")
  receivablesApproved         Receivable[]        @relation("ReceivableApprovedBy")
  receivablePaymentsReceived  ReceivablePayment[] @relation("ReceivablePaymentReceivedBy")
  thirdPartiesCreated         ThirdParty[]        @relation("ThirdPartyCreatedBy")
  thirdPartyPaymentsPaid      ThirdPartyPayment[] @relation("ThirdPartyPaymentPaidBy")
  thirdPartyPaymentsCancelled ThirdPartyPayment[] @relation("ThirdPartyPaymentCancelledBy")

  activatedEmergencyLocks   EmergencyLock[] @relation("EmergencyActivatedBy")
  deactivatedEmergencyLocks EmergencyLock[] @relation("EmergencyDeactivatedBy")

  auditLogs                AuditLog[]
  platformAuditLogs        PlatformAuditLog[]           @relation("PlatformAuditActor")
  openedSupportSessions    PlatformSupportSession[]     @relation("PlatformSupportOpenedBy")
  closedSupportSessions    PlatformSupportSession[]     @relation("PlatformSupportClosedBy")
  chatConversationsCreated  ChatConversation[]           @relation("ChatConversationCreatedBy")
  chatSupportAssignments    ChatConversation[]           @relation("ChatSupportAssignedTo")
  chatParticipants         ChatParticipant[]            @relation("ChatParticipantUser")
  chatMessagesSent         ChatMessage[]                @relation("ChatMessageSender")
  chatDeviceKeys           ChatDeviceKey[]              @relation("ChatDeviceKeyUser")
  chatReactions            ChatMessageReaction[]        @relation("ChatReactionUser")
  chatMentions             ChatMessageMention[]         @relation("ChatMentionUser")
  leadsAssigned            CommercialLead[]             @relation("LeadAssignedTo")
  leadsReviewed            CommercialLead[]             @relation("LeadReviewedBy")
  notifications             InternalNotification[]       @relation("NotificationUser")
  notificationPreferences   UserNotificationPreference[] @relation("UserNotifPrefs")
  sessions                  UserSession[]                @relation("UserSessionUser")
  adminPushSubscriptions    AdminPushSubscription[]      @relation("AdminPushSubs")
  ownedTenantAccounts       Tenant[]                     @relation("TenantAccountOwner")
  assignedCollectionCases   TenantCollectionCase[]       @relation("CollectionAssignedTo")
  accountActivitiesAuthored TenantAccountActivity[]      @relation("PlatformAccountActivityActor")

  @@index([status])
  @@map("users")
}

model TenantUser {
  id       String @id @default(uuid())
  tenantId String
  userId   String

  role   UserRole
  status TenantUserStatus @default(ACTIVE)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  overrides UserPermissionOverride[]

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([role])
  @@map("tenant_users")
}

model ChatConversation {
  id            String               @id @default(uuid())
  tenantId      String
  type          ChatConversationType @default(DIRECT)
  title         String?
  createdById   String?
  assignedToId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo User?  @relation("ChatSupportAssignedTo", fields: [assignedToId], references: [id])
  createdBy User?  @relation("ChatConversationCreatedBy", fields: [createdById], references: [id])

  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([tenantId])
  @@index([type])
  @@index([updatedAt])
  @@index([tenantId, updatedAt(sort: Desc)])
  @@map("chat_conversations")
}

model ChatParticipant {
  id             String              @id @default(uuid())
  tenantId       String
  conversationId String
  userId         String
  role           ChatParticipantRole @default(MEMBER)
  lastReadAt     DateTime?
  muted          Boolean             @default(false)
  archived       Boolean             @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation("ChatParticipantUser", fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([conversationId])
  @@map("chat_participants")
}

model ChatMessage {
  id                     String          @id @default(uuid())
  tenantId               String
  conversationId         String
  senderId               String?
  type                   ChatMessageType @default(TEXT)
  body                   String
  clientEncryptedPayload Json?
  deletedAt              DateTime?
  editedAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replyToId  String?
  pinnedAt   DateTime?
  pinnedById String?

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation ChatConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?                 @relation("ChatMessageSender", fields: [senderId], references: [id])
  replyTo      ChatMessage?          @relation("ChatMessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      ChatMessage[]         @relation("ChatMessageReply")
  reactions    ChatMessageReaction[]
  mentions     ChatMessageMention[]

  @@index([tenantId])
  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([replyToId])
  @@index([conversationId, createdAt(sort: Desc)])
  @@map("chat_messages")
}

model ChatMessageReaction {
  id        String   @id @default(uuid())
  tenantId  String
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation("ChatReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([tenantId])
  @@map("chat_message_reactions")
}

model ChatMessageMention {
  id        String   @id @default(uuid())
  tenantId  String
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation("ChatMentionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@index([tenantId])
  @@map("chat_message_mentions")
}

model ChatDeviceKey {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String
  deviceId   String
  deviceName String?
  userAgent  String?
  publicKey  String
  algorithm  String    @default("ECDH-P256")
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("ChatDeviceKeyUser", fields: [userId], references: [id])

  @@unique([tenantId, userId, deviceId])
  @@index([tenantId])
  @@index([userId])
  @@index([active])
  @@map("chat_device_keys")
}

model PlatformPlan {
  id           String             @id @default(uuid())
  code         String             @unique
  name         String
  description  String?
  priceMonthly Decimal            @default(0) @db.Decimal(10, 2)
  priceAnnual  Decimal?           @db.Decimal(10, 2)
  currency     String             @default("EUR")
  maxUsers     Int?
  maxProducts  Int?
  features     Json?
  status       PlatformPlanStatus @default(ACTIVE)

  // Marketing fields
  publicVisible        Boolean   @default(true)
  marketingTitle       String?
  marketingDescription String?
  isRecommended        Boolean   @default(false)
  sortOrder            Int       @default(0)
  ctaLabel             String?
  offerLabel           String?
  offerEndsAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions   TenantSubscription[]
  modules         PlatformPlanModule[]
  commercialLeads CommercialLead[]

  @@index([status])
  @@index([publicVisible])
  @@map("platform_plans")
}

enum CommercialLeadStatus {
  NEW
  IN_REVIEW
  WAITING_PAYMENT
  APPROVED
  REJECTED
  ACCESS_SENT
  ARCHIVED
}

enum CommercialLeadPaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

model CommercialLead {
  id                String  @id @default(uuid())
  name              String
  email             String
  phone             String?
  companyName       String
  country           String  @default("ES")
  preferredLanguage String  @default("es")
  requestedPlanId   String?
  estimatedUsers    Int?
  message           String?
  consentGiven      Boolean @default(false)
  source            String  @default("landing")

  status        CommercialLeadStatus        @default(NEW)
  paymentStatus CommercialLeadPaymentStatus @default(NOT_REQUIRED)

  assignedToId      String?
  reviewedById      String?
  convertedTenantId String?   @unique
  reviewedAt        DateTime?
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  convertedAt       DateTime?
  internalNotes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestedPlan   PlatformPlan? @relation(fields: [requestedPlanId], references: [id], onDelete: SetNull)
  assignedTo      User?         @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  reviewedBy      User?         @relation("LeadReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  convertedTenant Tenant?       @relation(fields: [convertedTenantId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("commercial_leads")
}

model TenantSubscription {
  id       String  @id @default(uuid())
  tenantId String  @unique
  planId   String?

  status        TenantSubscriptionStatus @default(ACTIVE)
  startsAt      DateTime                 @default(now())
  nextRenewalAt DateTime?
  endsAt        DateTime?
  trialEndsAt   DateTime?
  suspendedAt   DateTime?
  cancelledAt   DateTime?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   PlatformPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([planId])
  @@index([status])
  @@map("tenant_subscriptions")
}

model PlatformModuleDefinition {
  id          String               @id @default(uuid())
  key         String               @unique
  name        String
  description String?
  category    String               @default("Operativa")
  sortOrder   Int                  @default(0)
  status      PlatformModuleStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants TenantModule[]
  plans   PlatformPlanModule[]

  @@index([status])
  @@index([category])
  @@map("platform_module_definitions")
}

model PlatformPlanModule {
  id       String @id @default(uuid())
  planId   String
  moduleId String

  createdAt DateTime @default(now())

  plan   PlatformPlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  module PlatformModuleDefinition @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([planId, moduleId])
  @@index([planId])
  @@index([moduleId])
  @@map("platform_plan_modules")
}

model TenantModule {
  id       String @id @default(uuid())
  tenantId String
  moduleId String

  status     TenantModuleStatus @default(ENABLED)
  enabledAt  DateTime?
  disabledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module PlatformModuleDefinition @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
  @@index([tenantId])
  @@index([moduleId])
  @@index([status])
  @@map("tenant_modules")
}

model TenantContact {
  id        String  @id @default(uuid())
  tenantId  String
  name      String
  role      String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([isPrimary])
  @@map("tenant_contacts")
}

model TenantOnboardingTask {
  id          String               @id @default(uuid())
  tenantId    String
  title       String
  description String?
  status      OnboardingTaskStatus @default(PENDING)
  owner       String?
  dueAt       DateTime?
  completedAt DateTime?
  sortOrder   Int                  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([tenantId, sortOrder])
  @@map("tenant_onboarding_tasks")
}

// ======================================================
// PERMISOS
// ======================================================

model TenantCollectionCase {
