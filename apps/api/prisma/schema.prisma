}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?
  module      String

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  role         UserRole
  permissionId String

  createdAt DateTime @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

model UserPermissionOverride {
  id           String  @id @default(uuid())
  tenantUserId String
  permissionId String
  allowed      Boolean

  createdBy String?
  createdAt DateTime @default(now())

  tenantUser TenantUser @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tenantUserId, permissionId])
  @@index([tenantUserId])
  @@map("user_permission_overrides")
}

// ======================================================
// SOCIOS
// ======================================================

model Member {
  id       String @id @default(uuid())
  tenantId String

  memberNumber String
  firstName    String?
  lastName     String?
  displayName  String?

  documentType   String?
  documentNumber String?

  birthDate       DateTime?
  phone           String?
  email           String?
  address         String?
  city            String?
  postalCode      String?
  profileNotes    String?
  internalNotes   String?
  photoUrl        String?
  photoStorageKey String?

  status                 MemberStatus @default(PENDING)
  memberClass            MemberClass  @default(STANDARD)
  preferredContactMethod String?
  marketingConsent       Boolean      @default(false)
  joinedAt               DateTime     @default(now())
  lastVisitAt            DateTime?

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdBy User? @relation("MemberCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("MemberUpdatedBy", fields: [updatedById], references: [id])

  notes              MemberNote[]
  incidents          MemberIncident[]
  sales              Sale[]
  receivables        Receivable[]
  receivablePayments ReceivablePayment[]
  memberSessions     MemberSession[]           @relation("MemberSessions")
  pointBalances      MemberPointBalance[]      @relation("MemberPointBalance")
  pointTransactions  MemberPointTransaction[]  @relation("MemberPointTransactions")
  gamePlays          RewardGamePlay[]          @relation("MemberGamePlays")
  missionProgress    MemberMissionProgress[]   @relation("MemberMissionProgress")
  rewardRedemptions  RewardRedemption[]        @relation("MemberRedemptions")
  gameSessions       RewardGameSession[]       @relation("MemberGameSessions")
  pushSubscriptions  MemberPushSubscription[]  @relation("MemberPushSubs")

  @@unique([tenantId, memberNumber])
  @@unique([tenantId, documentNumber])
  @@index([tenantId])
  @@index([status])
  @@index([memberClass])
  @@index([firstName, lastName])
  @@map("members")
}

model MemberClassConfig {
  id       String @id @default(uuid())
  tenantId String

  memberClass           MemberClass @default(STANDARD)
  label                 String
  description           String?
  suggestedBonification Decimal     @default(0) @db.Decimal(10, 2)
  birthdayBonification  Decimal     @default(0) @db.Decimal(10, 2)
  requirePhoto          Boolean     @default(false)
  isDefault             Boolean     @default(false)
  isActive              Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantSettings TenantSettings @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@unique([tenantId, memberClass])
  @@index([tenantId])
  @@map("member_class_config")
}

model MemberClassBenefit {
  id          String      @id @default(uuid())
  tenantId    String
  memberClass MemberClass

  discountPercent         Decimal @default(0) @db.Decimal(5, 2)
  birthdayBenefitEnabled  Boolean @default(false)
  birthdayDiscountPercent Decimal @default(0) @db.Decimal(5, 2)
  birthdayGiftNote        String?
  allowSpecialCreditLimit Boolean @default(false)
  creditLimitAmount       Decimal @default(0) @db.Decimal(10, 2)
  notes                   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, memberClass])
  @@index([tenantId])
  @@map("member_class_benefits")
}

model MemberNote {
  id       String @id @default(uuid())
  tenantId String
  memberId String

  note       String
  visibility MemberNoteVisibility @default(MANAGER_AND_OWNER)

  createdBy String?
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([memberId])
  @@map("member_notes")
}

model MemberIncident {
  id       String @id @default(uuid())
  tenantId String
  memberId String

  type        IncidentType
  severity    IncidentSeverity @default(LOW)
  description String
  status      IncidentStatus   @default(OPEN)

  createdBy  String?
  resolvedBy String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([memberId])
  @@index([status])
  @@index([severity])
  @@map("member_incidents")
}

// ======================================================
// PRODUCTOS Y STOCK
// ======================================================

model ProductCategory {
  id       String @id @default(uuid())
  tenantId String

  name        String
  description String?
  status      ProductStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("product_categories")
}

model Product {
  id         String  @id @default(uuid())
  tenantId   String
  categoryId String?

  name        String
  description String?
  sku         String?
  barcode     String?

  unitType UnitType @default(UNIT)

  price Decimal  @db.Decimal(10, 2)
  cost  Decimal? @db.Decimal(10, 2)

  imageUrl String?
  status   ProductStatus @default(ACTIVE)

  minimumStock         Decimal? @db.Decimal(10, 3)
  idealStock           Decimal? @db.Decimal(10, 3)
  allowDecimalQuantity Boolean  @default(true)
  trackStock           Boolean  @default(true)

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category  ProductCategory? @relation(fields: [categoryId], references: [id])
  createdBy User?            @relation("ProductCreatedBy", fields: [createdById], references: [id])

  inventory Inventory?
  movements InventoryMovement[]
  saleItems SaleItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([categoryId])
  @@index([status])
  @@index([tenantId, status])
  @@map("products")
}

model Inventory {
  id        String @id @default(uuid())
  tenantId  String
  productId String @unique

  currentQuantity  Decimal   @default(0) @db.Decimal(12, 3)
  minimumQuantity  Decimal   @default(0) @db.Decimal(12, 3)
  maximumQuantity  Decimal?  @db.Decimal(12, 3)
  reservedQuantity Decimal   @default(0) @db.Decimal(12, 3)
  lostQuantity     Decimal   @default(0) @db.Decimal(12, 3)
  totalStockIn     Decimal   @default(0) @db.Decimal(12, 3)
  totalStockOut    Decimal   @default(0) @db.Decimal(12, 3)
  lastMovementAt   DateTime?

  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("inventory")
}

model InventoryMovement {
  id        String @id @default(uuid())
  tenantId  String
  productId String

  type             InventoryMovementType
  quantity         Decimal               @db.Decimal(12, 6)
  previousQuantity Decimal               @db.Decimal(12, 6)
  newQuantity      Decimal               @db.Decimal(12, 6)

  reason        String?
  notes         String?
  source        String?
  batchCode     String?
  unitCost      Decimal? @db.Decimal(10, 2)
  totalCost     Decimal? @db.Decimal(10, 2)
  referenceType String?
  referenceId   String?

  createdById String?
  createdAt   DateTime @default(now())

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("inventory_movements")
}

// ======================================================
// TPV Y CAJA
// ======================================================

model PosSession {
  id       String @id @default(uuid())
  tenantId String

  openedById String
  closedById String?

  openingCash       Decimal  @default(0) @db.Decimal(10, 2)
  closingCash       Decimal? @db.Decimal(10, 2)
  expectedCash      Decimal? @db.Decimal(10, 2)
  difference        Decimal? @db.Decimal(10, 2)
  closingSignature  String?  @db.Text
  discrepancyReason String?

  status PosSessionStatus @default(OPEN)

  openedAt DateTime  @default(now())
  closedAt DateTime?

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openedBy User   @relation("PosSessionOpenedBy", fields: [openedById], references: [id])
  closedBy User?  @relation("PosSessionClosedBy", fields: [closedById], references: [id])

  sales              Sale[]
  cashMovements      CashMovement[]
  receivablePayments ReceivablePayment[]
  thirdPartyPayments ThirdPartyPayment[]

  @@index([tenantId])
  @@index([openedById])
  @@index([status])
  @@index([openedAt])
  @@index([tenantId, openedById, status, openedAt(sort: Desc)])
  @@index([tenantId, openedAt(sort: Desc)])
  @@map("pos_sessions")
}

model Sale {
  id       String @id @default(uuid())
  tenantId String

  memberId     String
  posSessionId String
  soldById     String

  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  amountPaid       Decimal          @default(0) @db.Decimal(10, 2)
  amountPending    Decimal          @default(0) @db.Decimal(10, 2)
  settlementStatus SettlementStatus @default(PAID)
  saleType         SaleType         @default(STANDARD)
  creditReason     String?
  approvedById     String?
  specialReason    String?

  status SaleStatus @default(COMPLETED)

  createdAt DateTime @default(now())

  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member      Member     @relation(fields: [memberId], references: [id])
  posSession  PosSession @relation(fields: [posSessionId], references: [id])
  soldBy      User       @relation("SaleSoldBy", fields: [soldById], references: [id])
  cancelledBy User?      @relation("SaleCancelledBy", fields: [cancelledById], references: [id])
  approvedBy  User?      @relation("SaleApprovedBy", fields: [approvedById], references: [id])

  items         SaleItem[]
  payments      Payment[]
  receivable    Receivable?
  cashMovements CashMovement[]

  @@index([tenantId])
  @@index([memberId])
  @@index([posSessionId])
  @@index([soldById])
  @@index([approvedById])
  @@index([status])
  @@index([settlementStatus])
  @@index([saleType])
  @@index([createdAt])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, memberId, status, createdAt(sort: Desc)])
  @@map("sales")
}

model SaleItem {
  id        String @id @default(uuid())
  tenantId  String
  saleId    String
  productId String

  productNameSnapshot    String
  quantity               Decimal             @db.Decimal(12, 6)
  unitPrice              Decimal             @db.Decimal(10, 2)
  total                  Decimal             @db.Decimal(10, 2)
  pricingMode            SaleItemPricingMode @default(BY_UNIT)
  requestedAmount        Decimal?            @db.Decimal(10, 2)
  actualWeight           Decimal?            @db.Decimal(12, 6)
  weightDifference       Decimal?            @db.Decimal(12, 6)
  wasteQuantity          Decimal?            @db.Decimal(12, 6)
  scaleVerified          Boolean             @default(false)
  scaleVerifiedAt        DateTime?
  scaleVerifiedById      String?
  scaleToleranceExceeded Boolean             @default(false)
  scaleOverrideReason    String?
  scaleOverrideById      String?

  createdAt DateTime @default(now())

  sale            Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id])
  scaleVerifiedBy User?   @relation("SaleItemScaleVerifiedBy", fields: [scaleVerifiedById], references: [id])
  scaleOverrideBy User?   @relation("SaleItemScaleOverrideBy", fields: [scaleOverrideById], references: [id])

  @@index([tenantId])
  @@index([saleId])
  @@index([productId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("sale_items")
}

model Payment {
  id       String @id @default(uuid())
  tenantId String
  saleId   String

  method PaymentMethod
  amount Decimal       @db.Decimal(10, 2)
  status PaymentStatus @default(COMPLETED)

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([saleId])
  @@index([method])
  @@index([status])
  @@map("payments")
}

model CashMovement {
  id           String  @id @default(uuid())
  tenantId     String
  posSessionId String
  saleId       String?

  type   CashMovementType
  amount Decimal          @db.Decimal(10, 2)
  reason String?

  createdById String
  createdAt   DateTime @default(now())

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posSession        PosSession         @relation(fields: [posSessionId], references: [id], onDelete: Cascade)
  sale              Sale?              @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdBy         User               @relation("CashMovementCreatedBy", fields: [createdById], references: [id])
  thirdPartyPayment ThirdPartyPayment?

  @@index([tenantId])
  @@index([posSessionId])
  @@index([saleId])
  @@index([type])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("cash_movements")
}

model ThirdParty {
  id       String @id @default(uuid())
  tenantId String

  name           String
  type           ThirdPartyType   @default(OTHER)
  documentNumber String?
  phone          String?
  email          String?
  notes          String?
  status         ThirdPartyStatus @default(ACTIVE)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?               @relation("ThirdPartyCreatedBy", fields: [createdById], references: [id])
  payments  ThirdPartyPayment[]

  @@index([tenantId])
  @@index([status])
  @@index([type])
  @@map("third_parties")
}

model ThirdPartyPayment {
  id           String  @id @default(uuid())
  tenantId     String
  thirdPartyId String?
  posSessionId String

  amount   Decimal                   @db.Decimal(10, 2)
  category ThirdPartyPaymentCategory @default(OTHER)
  status   ThirdPartyPaymentStatus   @default(PAID)

  reason String
  notes  String?

  paidById      String
  cancelledById String?
  cancelledAt   DateTime?
  cancelReason  String?

  cashMovementId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  thirdParty   ThirdParty?   @relation(fields: [thirdPartyId], references: [id])
  posSession   PosSession    @relation(fields: [posSessionId], references: [id])
  paidBy       User          @relation("ThirdPartyPaymentPaidBy", fields: [paidById], references: [id])
  cancelledBy  User?         @relation("ThirdPartyPaymentCancelledBy", fields: [cancelledById], references: [id])
  cashMovement CashMovement? @relation(fields: [cashMovementId], references: [id])

  @@index([tenantId])
  @@index([thirdPartyId])
  @@index([posSessionId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("third_party_payments")
}

model Receivable {
  id       String  @id @default(uuid())
  tenantId String
  memberId String
  saleId   String? @unique

  originalAmount    Decimal @db.Decimal(10, 2)
  paidAmount        Decimal @default(0) @db.Decimal(10, 2)
  outstandingAmount Decimal @db.Decimal(10, 2)

  status  ReceivableStatus @default(OPEN)
  dueDate DateTime?
  reason  String?

  createdById  String
  approvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale       Sale?               @relation(fields: [saleId], references: [id])
  member     Member              @relation(fields: [memberId], references: [id])
  createdBy  User                @relation("ReceivableCreatedBy", fields: [createdById], references: [id])
  approvedBy User?               @relation("ReceivableApprovedBy", fields: [approvedById], references: [id])
  payments   ReceivablePayment[]

  @@index([tenantId])
  @@index([memberId])
  @@index([saleId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("receivables")
}

model ReceivablePayment {
  id           String  @id @default(uuid())
  tenantId     String
  receivableId String
  memberId     String
  posSessionId String?

  amount Decimal @db.Decimal(10, 2)
  notes  String?

  receivedById String
  createdAt    DateTime @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receivable Receivable  @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  member     Member      @relation(fields: [memberId], references: [id])
  posSession PosSession? @relation(fields: [posSessionId], references: [id])
  receivedBy User        @relation("ReceivablePaymentReceivedBy", fields: [receivedById], references: [id])

  @@index([tenantId])
  @@index([receivableId])
  @@index([memberId])
  @@index([posSessionId])
  @@index([createdAt])
  @@map("receivable_payments")
}

// ======================================================
// SEGURIDAD Y ACCESOS
