  tenantId String

  tokenHash String           @unique
  status    AccessLinkStatus @default(ACTIVE)

  expiresAt  DateTime?
  lastUsedAt DateTime?

  createdBy String?
  createdAt DateTime @default(now())

  revokedAt DateTime?
  revokedBy String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([expiresAt])
  @@map("access_links")
}

model EmergencyLock {
  id       String @id @default(uuid())
  tenantId String

  status EmergencyLockStatus @default(ACTIVE)
  reason String?

  activatedById String
  activatedAt   DateTime @default(now())

  deactivatedById  String?
  deactivatedAt    DateTime?
  resolutionReason String?

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activatedBy   User   @relation("EmergencyActivatedBy", fields: [activatedById], references: [id])
  deactivatedBy User?  @relation("EmergencyDeactivatedBy", fields: [deactivatedById], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([activatedAt])
  @@map("emergency_locks")
