# ============================================================
# QuickPanel360 — API environment variables
# QuickAgence — https://quickagence.com
#
# Copia este archivo como ".env" para desarrollo local.
# NUNCA commits el archivo ".env" real (está en .gitignore).
#
# OBLIGATORIAS en producción: DATABASE_URL, JWT_SECRET,
#   CORS_ORIGIN, CHAT_ENCRYPTION_KEY
# ============================================================

# ── Runtime ─────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development
PORT=3000

# ── App URLs ────────────────────────────────────────────────
# URL base del panel web (usada para generar enlaces en emails, etc.)
APP_URL=http://localhost:3001
# URL pública de la API (usada internamente para callbacks / webhooks)
API_URL=http://localhost:3000
# URL base para access links del Portal del Socio
ACCESS_LINK_BASE_URL=http://localhost:3001

# ── Base de datos (PostgreSQL 16) ───────────────────────────
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
# connection_limit: máximo de conexiones del pool de Prisma
#   - desarrollo: 20
#   - producción: 50 (1 VPS), 100 (si escala a 2+ instancias API)
# pool_timeout: segundos antes de descartar una conexión del pool
DATABASE_URL="postgresql://cannaclub:cannaclub_password@localhost:5432/cannaclub_db?schema=public&connection_limit=20&pool_timeout=10"

# DATABASE_DIRECT_URL — necesario si se usa Prisma Accelerate / PgBouncer
# (usa la URL de la DB directamente, sin pool)
# DATABASE_DIRECT_URL=

# ── Redis 7 ─────────────────────────────────────────────────
# Usado por: cache, BullMQ, Socket.io Redis adapter, locks, notificaciones
# Formato: redis://HOST:PORT  o  redis://:PASSWORD@HOST:PORT
# VPS único:  redis://redis:6379
# 2 VPS:      redis://PRIVATE_IP_VPS2:6379
REDIS_URL=redis://localhost:6379
# Prefijo para claves Redis (útil si se comparte instancia entre proyectos)
REDIS_PREFIX=qp360:

# ── Autenticación ───────────────────────────────────────────
# JWT_SECRET: mínimo 32 caracteres aleatorios en producción
JWT_SECRET="cambia_esto_por_una_clave_larga_y_segura"
JWT_EXPIRES_IN="1d"
# JWT separado para Portal del Socio (si aplica)
MEMBER_JWT_SECRET="cambia_esto_por_otra_clave_larga_y_segura"
MEMBER_JWT_EXPIRES_IN="7d"

# ── CORS ────────────────────────────────────────────────────
# En producción, pon el dominio exacto del panel web.
# Múltiples orígenes separados por comas:
#   CORS_ORIGIN=https://app.tudominio.com,https://socios.tudominio.com
# En producción, si está vacío → se bloquea todo (seguro por defecto).
CORS_ORIGIN=http://localhost:3001

# ── Proxy / seguridad ───────────────────────────────────────
# Necesario si la API está detrás de Nginx/Caddy/Traefik para que
# los IPs en logs y rate limiter sean correctos (no los del proxy).
TRUST_PROXY=true
# Límite del body de las peticiones HTTP
REQUEST_BODY_LIMIT=1mb

# ── Mantenimiento ───────────────────────────────────────────
# MAINTENANCE_MODE=true bloquea todos los endpoints excepto /health, /ready, /version
# Tiene prioridad sobre cualquier configuración en base de datos.
MAINTENANCE_MODE=false
# Mensaje personalizado mostrado al usuario (opcional)
MAINTENANCE_MESSAGE=
# ISO 8601 — fecha/hora estimada de fin del mantenimiento (opcional)
MAINTENANCE_ESTIMATED_END=

# ── Chat cifrado ────────────────────────────────────────────
# OBLIGATORIO en producción. Genera con: openssl rand -base64 32
CHAT_ENCRYPTION_KEY_ID=v1
CHAT_ENCRYPTION_KEY=clave_de_desarrollo_no_usar_en_produccion
# Claves anteriores (rotación): KEY_ID:BASE64_KEY,KEY_ID2:BASE64_KEY2
CHAT_ENCRYPTION_PREVIOUS_KEYS=
# Días de retención de mensajes (0 = sin límite)
CHAT_RETENTION_DAYS=0

# ── Storage de archivos ─────────────────────────────────────
# STORAGE_TYPE: "local" | "s3"
# En producción con S3/R2, cambiar a "s3" y rellenar las variables siguientes.
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=storage/uploads
STORAGE_PRIVATE_DIR=storage/private

# S3 / Cloudflare R2 compatible
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública base para acceder a los archivos (sin barra final)
S3_PUBLIC_URL=
# Región (obligatoria para AWS S3, opcional para R2)
S3_REGION=auto

# ── Backups ─────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
# Driver para subir backups: "local" | "s3"
BACKUP_STORAGE_DRIVER=local

# ── Observabilidad / Sentry ─────────────────────────────────
# Dejar vacío para desactivar Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# ── Build / versión (se inyectan en CI, no editar manualmente) ──
APP_VERSION=1.0.0
GIT_SHA=
BUILD_DATE=

# ── Email (Resend) ──────────────────────────────────────────
# Necesario para envío de emails (access links, notificaciones, etc.)
RESEND_API_KEY=
EMAIL_FROM=noreply@quickagence.com
