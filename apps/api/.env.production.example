# ============================================================
# QuickPanel360 — API production environment
# QuickAgence
#
# 1. Copia como apps/api/.env.production
# 2. Rellena TODOS los valores CHANGE_ME
# 3. NUNCA dejes este archivo en el repo con valores reales
# ============================================================

NODE_ENV=production
APP_ENV=production
PORT=3000

# ── App URLs ─────────────────────────────────────────────────
# Reemplaza "tudominio.com" con tu dominio real
APP_URL=https://app.tudominio.com
API_URL=https://api.tudominio.com
ACCESS_LINK_BASE_URL=https://app.tudominio.com

# ── Base de datos ────────────────────────────────────────────
# VPS único:
#   DATABASE_URL=postgresql://cannaclub:CHANGE_ME@postgres:5432/cannaclub_db?schema=public&connection_limit=50&pool_timeout=10
# 2 VPS (PostgreSQL en VPS2, IP privada):
#   DATABASE_URL=postgresql://cannaclub:CHANGE_ME@PRIVATE_IP_VPS2:5432/cannaclub_db?schema=public&connection_limit=50&pool_timeout=10
DATABASE_URL=postgresql://cannaclub:CHANGE_ME@postgres:5432/cannaclub_db?schema=public&connection_limit=50&pool_timeout=10

# ── Redis ─────────────────────────────────────────────────────
# VPS único:
#   REDIS_URL=redis://redis:6379
# 2 VPS (Redis en VPS2, IP privada):
#   REDIS_URL=redis://:REDIS_PASSWORD@PRIVATE_IP_VPS2:6379
# Con autenticación:
#   REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_URL=redis://redis:6379
REDIS_PREFIX=qp360:

# ── Autenticación ─────────────────────────────────────────────
# Genera con: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_32_CHARS_MIN
JWT_EXPIRES_IN=8h
MEMBER_JWT_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_SECRET
MEMBER_JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=https://app.tudominio.com

# ── Proxy ────────────────────────────────────────────────────
TRUST_PROXY=true
REQUEST_BODY_LIMIT=1mb

# ── Mantenimiento ─────────────────────────────────────────────
# Activa desde aquí o reiniciando el contenedor con esta variable
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=
MAINTENANCE_ESTIMATED_END=

# ── Chat cifrado ──────────────────────────────────────────────
# Genera con: openssl rand -base64 32
CHAT_ENCRYPTION_KEY_ID=v1
CHAT_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY
CHAT_ENCRYPTION_PREVIOUS_KEYS=
CHAT_RETENTION_DAYS=90

# ── Storage ───────────────────────────────────────────────────
# Empieza con "local" y migra a "s3" cuando tengas R2/S3
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=/app/storage/uploads
STORAGE_PRIVATE_DIR=/app/storage/private
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_REGION=auto

# ── Backups ───────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_DRIVER=local

# ── Sentry ────────────────────────────────────────────────────
# Opcional pero muy recomendado en producción
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── Build info (inyectado por CI) ─────────────────────────────
APP_VERSION=1.0.0
GIT_SHA=
BUILD_DATE=

# ── Email ────────────────────────────────────────────────────
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=noreply@tudominio.com
